# Keep the paid route disabled until the receiving address and environment are verified.
CCC_X402_ENABLED=false

# Base-compatible address that receives USDC.
CCC_X402_PAY_TO=0xYOUR_BASE_RECEIVING_ADDRESS

# USD-denominated price per successful request.
CCC_X402_PRICE_USD=0.02

# Base Sepolia. Mainnet is eip155:8453.
CCC_X402_NETWORK=eip155:84532

# The public facilitator below is for testnet only.
CCC_X402_FACILITATOR_URL=https://x402.org/facilitator

CCC_X402_PUBLIC_URL=https://cryptococktail.club/api/x402/bartender

# Existing internal AI fallback; leave unset to run deterministic recipe logic only.
OPENAI_API_KEY=
